{
  "name": "zupka",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter '@zupka/*' --parallel dev",
    "build": "pnpm --filter @zupka/web build && pnpm --filter @zupka/api build",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @zupka/web typecheck",
    "test": "vp test run",
    "check": "vp check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@types/node": "26.6.5",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.14.0"
}
